{
  "name": "dsh-more-agent-presets",
  "version": "1.5.3",
  "description": "多个可选择的 DeepSeek Harness Agent Presets 集合（声明式 preset bundle，DSH 0.2.0-rc.1+）",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./presets/*": "./presets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "presets",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/codex-coding-agent.patch.yml",
        "./presets/iflow-coding-agent.patch.yml",
        "./presets/iflow-cre-agent.patch.yml",
        "./presets/pair-coding-agent.patch.yml",
        "./presets/qwencode-coding-agent.patch.yml"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-instructions": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-agent-preset": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-command-compact": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-compaction-basic": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-persona": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-plan-mode": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-skill-filesystem": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tool-ask-user": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tool-bash": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tool-fs": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tool-fs-search": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tool-goal": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tool-jobs": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tool-pwsh": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tool-ralph": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tool-skill": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tool-subagent": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tool-subagent-control": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tool-todo": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tool-web": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tool-workflow": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-workflow-ptc": "^0.2.0-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.5",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/R-LEI2536/dsh-more-agent-presets.git"
  },
  "homepage": "https://github.com/R-LEI2536/dsh-more-agent-presets#readme",
  "bugs": {
    "url": "https://github.com/R-LEI2536/dsh-more-agent-presets/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "agent-preset",
    "coding-agent",
    "qwencode",
    "iflow",
    "codex"
  ],
  "license": "MIT"
}
